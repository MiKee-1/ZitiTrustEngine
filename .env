# --- OpenZiti image ---
ZITI_IMAGE=openziti/quickstart
ZITI_VERSION=latest

# --- controller admin credentials (lab only: change these outside a local context) ---
ZITI_USER=admin
ZITI_PWD=admin

# --- addresses/ports advertised by the controller ---
ZITI_CTRL_NAME=ziti-controller
ZITI_CTRL_EDGE_ADVERTISED_ADDRESS=ziti-controller
ZITI_CTRL_EDGE_ADVERTISED_PORT=1280
ZITI_CTRL_ADVERTISED_ADDRESS=ziti-controller
ZITI_CTRL_ADVERTISED_PORT=6262

# port of the Edge Management API, separate from the Edge Client API (1280).
# Exposed ONLY on the controller's IP on the "it" network (see docker-compose.yml):
# a client on the "ot" network (the gateways) has no route to this address at all.
ZITI_CTRL_MGMT_PORT=1281

ZITI_EDGE_IDENTITY_ENROLLMENT_DURATION=10080
ZITI_ROUTER_ENROLLMENT_DURATION=10080

# --- router ---
ZITI_ROUTER_NAME=ziti-router
ZITI_ROUTER_ADVERTISED_ADDRESS=ziti-router
ZITI_ROUTER_PORT=3022
ZITI_ROUTER_LISTENER_BIND_PORT=10080
ZITI_ROUTER_ROLES=public

# --- Docker subnets ---
OT_SUBNET=10.19.1.0/24
IT_SUBNET=10.19.2.0/24

# --- static IPs ---
CTRL_OT_IP=10.19.1.10
CTRL_IT_IP=10.19.2.10
ROUTER_OT_IP=10.19.1.11
ROUTER_IT_IP=10.19.2.11
ZITI_HOST_IT_IP=10.19.2.20
HISTORIAN_IT_IP=10.19.2.30
GATEWAY_A_OT_IP=10.19.1.21
GATEWAY_B_OT_IP=10.19.1.22
